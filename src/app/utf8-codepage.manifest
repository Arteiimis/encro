<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!--
    Narrow text in this program is UTF-8: command-line arguments, config values,
    job-state.json and every path that travels between them.

    A Windows process converts between narrow and wide text with its active code
    page, so on a machine whose code page is not UTF-8 every CJK path fails to
    convert ("No mapping for the Unicode character exists in the target
    multi-byte code page") - in the C runtime, in third-party libraries that take
    narrow paths, and in anything else that calls the ANSI APIs. Declaring UTF-8
    as the process code page makes all of them agree with what the program
    already assumes. Windows 10 1903 and later honour this element.
  -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
