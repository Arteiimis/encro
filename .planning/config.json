{
  "model_profile": "balanced",
  "commit_docs": true,
  "response_language": "zh-CN",
  "runtime": "opencode",
  "context_window": 1000000,
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "auto_advance": false,
    "nyquist_validation": true,
    "pattern_mapper": true,
    "ui_phase": false,
    "ui_safety_gate": false,
    "ai_integration_phase": true,
    "tdd_mode": true,
    "code_review": true,
    "code_review_depth": "standard",
    "ui_review": false,
    "text_mode": false,
    "research_before_questions": false,
    "discuss_mode": "discuss",
    "skip_discuss": false,
    "use_worktrees": true
  },
  "parallelization": {
    "max_concurrent_agents": 5
  },
  "intel": {
    "enabled": false
  },
  "graphify": {
    "enabled": false
  },
  "git": {
    "branching_strategy": "milestone"
  },
  "hooks": {
    "context_warnings": true
  }
}
